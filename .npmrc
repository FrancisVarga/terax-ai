; Windows: a filesystem filter driver (antivirus) blocks Node/libuv from
; traversing symlink reparse points in node_modules (stat -> UNKNOWN -4094),
; which breaks native-binding resolution (e.g. @tauri-apps/cli-win32-x64-msvc).
; Use a flat, real-directory layout instead of pnpm's symlinked store.
node-linker=hoisted
; Windows secondary-volume (E:) blocks reparse-point traversal with
; "untrusted mount point" even with R2R/R2L enabled. Disable pnpm's
; internal symlinks so the store uses only real directories / hardlinks.
symlink=false
