# Generated by Cargo
# will have compiled files and executables
/target/
# Isolated build dir for the terax-dbg binary (avoids prod target lock).
/target-dbg/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Machine-specific MSVC toolchain shim (CC/CXX/INCLUDE pins).
# Absolute, space-containing paths that cc-rs cannot parse and that break CI.
# Kept local-only: each dev box regenerates from its own VS2022 vcvars64.bat.
/.cargo/config.toml
.rmux-daemon-e2e.exe
