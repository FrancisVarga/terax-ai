# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.omc

# Per-developer Claude Code / agent tooling state (local settings, task locks).
.claude/

node_modules
dist
dist-ssr
*.local
.gitstatus.tmp

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.rust-analyzer-target
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
sast-rnd
*.tsbuildinfo
.env

# bunqueue sidecars — compiled per-platform by `pnpm build:sidecars`, not committed
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# Bun incremental build artifacts (e.g. .<hash>-00000000.bun-build)
*.bun-build

# Machine-specific local-dev cargo build shim (MSVC toolchain pin).
# Must NOT be committed: its hardcoded VS BuildTools paths break CI's native
# compiler detection (cc-rs cannot parse the space in "C:\Program Files").
src-tauri/.cargo/

# Compiled Vite config artifacts (source is vite.config.ts)
vite.config.js
vite.config.d.ts
